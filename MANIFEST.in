include README.md README.zh-CN.md LICENSE NOTICE CHANGELOG.md CONTRIBUTING.md SECURITY.md
include .gitignore .gitattributes .editorconfig .env.example
recursive-include docs *.md *.json
recursive-include examples *.md *.py *.json
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github *.yml *.yaml *.md
recursive-include src *.py py.typed
global-exclude *.py[cod] __pycache__
